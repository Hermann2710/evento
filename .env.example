# --- Database (required: Neon pooled connection string) ---
# Neon Console -> Connect -> select the pooled connection string, then replace this value.
# Keep sslmode=require and do not expose this value with a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# --- Auth.js (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the app (used for emails, canonical URLs, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth (optional: Google button appears only when both are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails via Resend (optional: emails are logged to the console when missing) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Evento <no-reply@evento.app>

# --- Cloudinary uploads (optional: falls back to HTTPS URL input when missing) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
# Provider name: "mock" (built-in sandbox provider). Add new providers in src/features/payments/providers
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
# Secret used to sign / verify webhooks (required)
PAYMENT_WEBHOOK_SECRET=

# --- Realtime (optional: UI falls back to polling when missing) ---
# Standalone Socket.IO server started with `npm run realtime`
NEXT_PUBLIC_SOCKET_URL=
REALTIME_INTERNAL_URL=http://127.0.0.1:4001
REALTIME_SECRET=
REALTIME_PORT=4001
